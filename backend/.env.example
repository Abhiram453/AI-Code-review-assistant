# Server Port
PORT=4005

# PostgreSQL Connection String
# When set to a running PostgreSQL instance, the backend connects via node-postgres (pg).
# If omitted or unreachable in local development, the backend automatically uses embedded PostgreSQL 16 (PGlite) persisted to ./data/pgdata
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/ai_code_review

# JWT Authentication Secret
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS Frontend Origin
FRONTEND_URL=http://localhost:3005

# Optional Default AI Provider Fallback (Can be configured per-user in the UI)
DEFAULT_AI_BASE_URL=http://localhost:1234/v1
DEFAULT_AI_MODEL=local-model
DEFAULT_AI_API_KEY=
